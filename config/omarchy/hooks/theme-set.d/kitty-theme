#!/bin/bash
# Regenerate the kitty palette after a theme change.
# $1 is the slugified theme name (unused -- the script reads current/theme.name,
# which is already the new theme by the time hooks run).
#
# NOTE: omarchy-theme-set:207 only runs hooks when OMARCHY_THEME_HEADLESS is
# unset, so this fires for theme-switcher / omarchy-theme-set changes but NOT
# for resync.sh, which sets it. resync.sh calls the same script directly.
exec "$HOME/.local/bin/omarchy-kitty-theme-sync"
