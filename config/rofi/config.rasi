/* ~/.config/rofi/config.rasi
 *
 * rofi replaces the Quickshell shell's app menu (SUPER + Space), which went
 * with the shell. Walker was the launcher before that and is also gone.
 *
 * The look lives in spotlight.rasi; this file is settings only.
 */

configuration {
    modes:                       "drun,run,window";
    font:                        "Inter 12";

    show-icons:                  true;
    icon-theme:                  "kora-grey";
    drun-display-format:         "{name}";
    drun-match-fields:           "name,generic,exec,categories,keywords";

    /* Matching that tolerates a typo, which a launcher on a hotkey wants. */
    matching:                    "fuzzy";
    sort:                        true;
    sorting-method:              "fzf";

    display-drun:                "Apps";
    display-run:                 "Run";
    display-window:              "Windows";

    /* SUPER+Space toggles rofi by killing a running instance (see
     * conf/keybinds.lua), so there is nothing to configure for dismissal
     * beyond the usual Escape. */
    kb-cancel:                   "Escape";
}

@theme "~/.config/rofi/spotlight.rasi"
