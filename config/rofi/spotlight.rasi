/* Spotlight-style rofi theme.
 *
 * edited by claude opus 5
 * rebuilt to the reference theme's actual numbers. The previous version used
 * the old indigo palette at a 14px radius, which made it a small dark box; the
 * reference is a wide, very transparent, heavily rounded sheet that leans on
 * the compositor's blur for legibility.
 *
 * Lineage: LR-Tech's macOS-Spotlight theme by way of KZDKM's dotfiles. Kept
 * from it: 640px wide, 24px radius, a single grey hairline, 20px input type
 * over 12px rows, and a selection that darkens and bolds rather than
 * colouring. Changed: the HiDPI sizing is dropped — one 1920x1080 display at
 * scale 1 — and the prompt is a glyph rather than a themed icon, so it does
 * not depend on an icon theme shipping "search".
 *
 * The background is #00000033: almost clear. It is readable only because
 * conf/rules.lua blurs the `rofi` layer. Raising the alpha here to "fix"
 * legibility is the wrong lever — it kills the glass.
 *
 * Same palette as config/waybar/style.css, config/mako/config and
 * config/hypr/conf/palette.lua. Edit together.
 */

* {
    font-family: "Inter";

    bg0:  #00000033;   /* the sheet: nearly clear, blurred by the compositor */
    bg1:  #7e7e7e80;   /* hairlines                                          */
    bg2:  #00000055;   /* selected row                                       */

    fg0:  #dedede;     /* normal text                                        */
    fg1:  #ffffff;     /* selected text                                      */
    fg2:  #dedede80;   /* placeholder                                        */
    fg3:  #0860f2;     /* running / active entries                           */

    background-color: transparent;
    text-color:       @fg0;

    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @bg0;

    location:      center;
    width:         640;
    border:        1px solid;
    border-color:  @bg1;
    border-radius: 24px;
}

/* edited by claude opus 5
 * search field dropped from 20 to 14: 20 is the reference's HiDPI size and at
 * scale 1 it towered over the 12px result rows. The results keep their own
 * size — only this bar changed. */
inputbar {
    font:     "Inter 14";
    padding:  14px 16px;
    spacing:  12px;
    children: [ prompt, entry ];
}

prompt {
    enabled:    true;
    expand:     false;
    text-color: @fg2;
    str:        "";
}

prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font:              inherit;
    placeholder:       "Search";
    placeholder-color: @fg2;
}

message {
    border:       1px 0 0;
    border-color: @bg1;
}

textbox {
    padding: 8px 24px;
}

listview {
    lines:        10;
    columns:      1;
    fixed-height: false;
    border:       1px 0 0;
    border-color: @bg1;
    scrollbar:    false;
}

element {
    padding: 8px 16px;
    spacing: 16px;
}

element normal active {
    text-color: @fg3;
}

element selected normal, element selected active {
    text-color:       @fg1;
    background-color: @bg2;
}

element-icon {
    size: 1em;
}

element-text {
    text-color: inherit;
}
