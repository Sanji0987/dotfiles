# Apple Stock -- notifications.
#
# mako has no include directive, so unlike every other file in this directory
# this one is COPIED over config/mako/config by bin/theme-set rather than being
# imported. That means geometry lives here too, and a layout change has to be
# made in each theme's copy. It is the one duplicated file in the set.

font=SF Pro Text, Inter 10

background-color=#000000bf
text-color=#dedede
border-color=#70707073
progress-color=over #0860f2

border-size=1
border-radius=10
padding=12,14
margin=8
width=380
height=160
icon-location=left
max-icon-size=40

default-timeout=5000
ignore-timeout=0
layer=overlay
anchor=top-right
outer-margin=12
max-visible=5
group-by=app-name

[urgency=low]
text-color=#7e7e7e
border-color=#39393973
default-timeout=3000

[urgency=normal]
border-color=#70707073

[urgency=critical]
text-color=#ffffff
border-color=#e05561cc
default-timeout=0

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb app-name=notify-send]
invisible=0
