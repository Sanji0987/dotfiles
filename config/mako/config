# ~/.config/mako/config
#
# edited by claude opus 5
# repalletted and reshaped to the reference look: near-black carried by alpha,
# a grey hairline, 10px radius to match Hyprland's window rounding
#
# Hand-maintained. Colours are literals, not sourced from a theme pipeline.
# Same palette as config/waybar/style.css, config/rofi/spotlight.rasi and
# config/hypr/conf/palette.lua — edit them together.
#
# The background carries alpha so the compositor's blur rule for the
# `notifications` layer has something to work with. Toasts are meant to read
# as the same material as the bar and the launcher.

font=Inter 10

background-color=#000000bf
text-color=#dedede
border-color=#70707073
progress-color=over #0860f2

border-size=1
border-radius=10
padding=12,14
margin=8
width=380
height=160
icon-location=left
max-icon-size=40

default-timeout=5000
ignore-timeout=0
layer=overlay
anchor=top-right
outer-margin=12
max-visible=5
group-by=app-name

[urgency=low]
text-color=#7e7e7e
border-color=#39393973
default-timeout=3000

[urgency=normal]
border-color=#70707073

[urgency=critical]
text-color=#ffffff
border-color=#e05561cc
default-timeout=0

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb app-name=notify-send]
invisible=0
