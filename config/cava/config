# cava — the audio visualiser in the rainynight theme's first screenshot.
#
# cava is NOT installed on this machine. This config is here so it works the
# moment it is (`sudo pacman -S cava`); nothing was installed to place it.
#
# edited by claude opus 5
# dropped the reference to the omarchy staging path and sync script, both gone
#
# edited by claude opus 5
# the active gradient is the neutral desktop's now; rainynight's is kept below
# it, commented out, because cava has no include directive and no generator
# behind it any more -- a second palette can only live here as dead lines
#
# Every colour here is a literal. To switch schemes, comment one gradient block
# out and uncomment the other; there is nothing else to change.

[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
# Terminal default, so cava sits on the kitty background rather than painting
# its own. That background already follows the theme.
background = default
gradient = 1
gradient_count = 8

# ---- ACTIVE: glass ----
# Dim grey at the bar roots up to white at the peaks, in even steps. The ramp
# does the work the hue used to do: loud is bright, quiet is nearly background.
gradient_color_1 = '#404040'
gradient_color_2 = '#555555'
gradient_color_3 = '#6b6b6b'
gradient_color_4 = '#808080'
gradient_color_5 = '#969696'
gradient_color_6 = '#ababab'
gradient_color_7 = '#c1c1c1'
gradient_color_8 = '#ffffff'

# ---- INACTIVE: rainynight ----
# The original gradient from the rainynight theme's cava_theme, preserved
# verbatim. Uncomment these eight and comment out the eight above to restore it.
# gradient_color_1 = '#91e3e1'
# gradient_color_2 = '#a7aaaf'
# gradient_color_3 = '#d7d8db'
# gradient_color_4 = '#e382d2'
# gradient_color_5 = '#f6cbee'
# gradient_color_6 = '#d9f7f6'
# gradient_color_7 = '#f6cbee'
# gradient_color_8 = '#91e3e1'

[smoothing]
noise_reduction = 77
