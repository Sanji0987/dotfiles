# cava — the audio visualiser in the rainynight theme's first screenshot.
#
# cava is NOT installed on this machine. This config is here so it works the
# moment it is (`sudo pacman -S cava`); nothing was installed to place it.
#
# The gradient below is copied from the theme's own cava_theme, staged at
# ~/.local/state/omarchy/current/theme/cava_theme. It does NOT follow a theme
# change: cava has no include directive, so a colour section cannot be sourced
# from elsewhere the way kitty's and hyprlock's are. If cava earns a place in
# the daily setup, the honest fix is a small sync script beside
# omarchy-kitty-theme-sync rather than hand-editing this block.

[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
# Terminal default, so cava sits on the kitty background rather than painting
# its own. That background already follows the theme.
background = default
gradient = 1
gradient_count = 8
gradient_color_1 = '#91e3e1'
gradient_color_2 = '#a7aaaf'
gradient_color_3 = '#d7d8db'
gradient_color_4 = '#e382d2'
gradient_color_5 = '#f6cbee'
gradient_color_6 = '#d9f7f6'
gradient_color_7 = '#f6cbee'
gradient_color_8 = '#91e3e1'

[smoothing]
noise_reduction = 77
