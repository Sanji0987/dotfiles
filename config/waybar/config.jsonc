// Waybar config — the bar.
//
// edited by claude opus 5
// ICONS ARE WRITTEN AS \uXXXX ESCAPES ON PURPOSE.
//
// Every glyph in this file was an empty string: the volume icons were
// ["", "", ""], mpris had no play/pause, network and bluetooth had none
// either — waybar rendered "20%" with nothing before it. Raw PUA characters
// do not survive being copied through tools that are not UTF-8 clean, and
// they are invisible in a diff when they go missing. Escapes survive, and a
// missing one is obvious on sight.
//
// All codepoints below are BMP (U+F000-U+F8FF, the Font Awesome block of Nerd
// Fonts) and verified present in JetBrainsMono Nerd Font. Avoid the
// Material-Design range (U+F0001+): it is outside the BMP, needs surrogate
// pairs in JSON, and one of those is what was silently failing on the Claude
// module.
//
// edited by claude opus 5
// no longer a fallback mirroring the Quickshell bar's widget list; laid out
// as its own thing now that it is what runs
//
// Layout follows the desktop this is modelled on: identity and context on the
// left (launcher, workspaces, focused window), time in the middle, and state
// on the right. Dropped from the old mirror: idle_inhibitor, keyboard layout,
// cpu and memory — all were stand-ins for omarchy.* widgets rather than things
// worth a permanent slot. btop covers cpu/memory better on demand.
{
  "layer": "top",
  "position": "top",
  // edited by claude opus 5
  // 30 -> 26: thin, close to a macOS menu bar. The reference is 42, but that
  // is sized around a display notch it has to clear; there is none here.
  //
  // 26 is about the floor at 12px type — the pills carry 0.4em vertical
  // margins, so going lower starts clipping them rather than thinning the bar.
  // Drop the font size first if you want it tighter than this.
  "height": 26,
  // 0: spacing between modules is set per-module in style.css as margins, the
  // way the reference stylesheet does it. A bar-wide spacing on top of that
  // double-spaces everything.
  "spacing": 0,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  // No centre group: the reference bar puts the clock on the right and leaves
  // the middle empty, which is what makes the window title on the left
  // readable as the focus of the bar.
  "modules-center": [],

  "modules-right": [
    "mpris#sidra",
    "mpris#spotify",
    "custom/claude",
    "tray",
    "network",
    "pulseaudio",
    "clock",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "Applications",
    "on-click": "pkill -x rofi || rofi -show drun"
  },

  // Numbers, not dots. The reference bar shows per-workspace app icons, but
  // plain ids are what is actually wanted here and they stay readable at 11px.
  "hyprland/workspaces": {
    "format": "{id}",
    // edited by claude opus 5
    // without an explicit on-click the buttons render but do nothing: waybar
    // does not bind workspace activation by default
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    }
  },

  // The focused window's title, trimmed. Empty on an empty workspace, which
  // is deliberate — the left side collapses rather than showing a placeholder.
  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Visual Studio Code": "$1",
      "(.*) - Dolphin": "$1"
    }
  },

  // edited by claude opus 5
  // "Sat 19 Sep 14:56" — weekday, date, 24h. The reference uses the same
  // shape ("April 10 Wednesday 22:59"); this is the shorter form.
  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "format-alt": "{:%-d %B 'W'%V %Y}",
    "on-click": "mode",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "custom/weather": {
    "exec": "curl -sf --max-time 5 'wttr.in/?format=%C+%t' || true",
    "interval": 1800,
    "tooltip": false
  },

  // edited by claude opus 5
  // scoped to the music apps only. waybar's mpris module has no allowlist —
  // `ignored-players` is a denylist, which would let any new player (mpv, vlc,
  // a second browser) take the slot. Two instances, each pinned to one player,
  // IS the allowlist: an instance whose player is not running renders nothing.
  //
  // Sidra registers on mpris as `sidra`. Spotify is not installed; its
  // instance sits here inert so it works the moment it is.
  "mpris#sidra": {
    "player": "sidra",
    "format": "{status_icon} {dynamic}",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 34,
    "status-icons": {
      "playing": "\uf04b",
      "paused": "\uf04c"
    },
    "tooltip-format": "{player}: {title}\n{artist} — {album}"
  },

  "mpris#spotify": {
    "player": "spotify",
    "format": "{status_icon} {dynamic}",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 34,
    "status-icons": {
      "playing": "\uf04b",
      "paused": "\uf04c"
    },
    "tooltip-format": "{player}: {title}\n{artist} — {album}"
  },

  // Claude Code usage. bin/waybar-claude reads the record that
  // bin/agent-usage-update writes and emits waybar JSON; it refreshes the
  // record itself when stale, so the interval here only re-renders.
  // Replaces the Quickshell shell's omarchy.agents widget.
  "custom/claude": {
    "exec": "waybar-claude",
    "return-type": "json",
    "interval": 60,
    "on-click": "agent-usage-update claude"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "bluetooth": {
    "format": "\uf293",
    "format-disabled": "\uf293",
    "format-connected": "\uf293 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "\uf1eb {signalStrength}%",
    "format-ethernet": "\uf0e8",
    "format-disconnected": "⚠",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\uf026 muted",
    "format-icons": {
      "default": ["\uf026", "\uf027", "\uf028"]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "left: lock   middle: reboot   right: power off",
    "on-click": "loginctl lock-session",
    "on-click-middle": "systemctl reboot",
    "on-click-right": "systemctl poweroff"
  }
}
