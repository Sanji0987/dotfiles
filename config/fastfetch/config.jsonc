// fastfetch — laid out to match the rainynight theme's screenshots.
//
// edited by claude opus 5
// the terminal palette is hand-maintained now, not generated; the mechanism
// this describes is gone but the reasoning for ANSI names still holds
//
// Colours are deliberately ANSI names ("white", "default") rather than hex.
// That makes them resolve through whatever the terminal palette is, so this
// file needs no colours of its own and tracks kitty's current-theme.conf for
// free.
//
// The screenshots show lowercase keys, no colons and no separator rule, which
// is what the display block below reproduces.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "arch_small",
    "color": { "1": "white" },
    "padding": { "left": 2, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 7 },
    "color": { "keys": "light_black", "title": "white" }
  },

  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "os", "key": "os" },
    { "type": "wm", "key": "de" },
    { "type": "packages", "key": "pkgs" },
    { "type": "shell", "key": "shell" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    // No built-in module reports this. Days since the first line of the pacman
    // log, which is the install itself -- on this machine, the Calamares run.
    {
      "type": "command",
      "key": "os age",
      "text": "d=$(awk 'NR==1{sub(/^\\[/,\"\");sub(/\\].*$/,\"\");print}' /var/log/pacman.log); echo \"$(( ( $(date +%s) - $(date -d \"$d\" +%s) ) / 86400 )) days\""
    },
    { "type": "memory", "key": "memory" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
