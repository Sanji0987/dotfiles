#!/bin/bash
# Generate Sidra's custom-theme.json from the active Omarchy theme.
#
# Sidra (an Electron Apple Music client, wimpysworld/sidra) supports exactly one
# extension point: a custom-theme.json in its userData directory holding twelve
# hex colour slots. dist/customTheme.js validates them strictly -- all twelve
# present, /^#[0-9a-f]{6}$/i, nothing else accepted -- and falls back to the
# stock Apple Music look if any of that fails. There is no custom-CSS setting,
# so this is the whole of what can be themed without repacking app.asar.
#
# Sidra watches the file and re-applies on change (150ms debounce), so a theme
# switch retints it live, with no restart.
#
# The slot names are Catppuccin's. The mix amounts below were tuned against
# Sidra's own shipped Catppuccin Mocha palette: feeding this script that theme's
# colors.toml reproduces its slots to within a couple of points per channel.
# Change them only with that comparison in hand.
#
# Run by the theme-set.d/sidra-theme hook, and directly by resync.sh, which
# sets OMARCHY_THEME_HEADLESS and so skips hooks.

set -euo pipefail

STATE="$HOME/.local/state/omarchy/current"
COLORS="$STATE/theme/colors.toml"
# Electron derives userData from productName, which is "Sidra".
USERDATA="$HOME/.config/Sidra"
TARGET="$USERDATA/custom-theme.json"

[[ -r $COLORS ]] || { echo "omarchy-sidra-theme-sync: no colors.toml at $COLORS" >&2; exit 1; }

# key = "#rrggbb" -> shell variable. Anything else in the file is ignored.
read_color() {
  local key="$1" value
  value=$(sed -nE "s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*\"(#[0-9a-fA-F]{6})\".*/\1/p" "$COLORS" | head -1)
  printf '%s' "$value"
}

# Blend two #rrggbb values. $3 is 0-100: 0 keeps $1, 100 becomes $2.
mix() {
  local a="${1#\#}" b="${2#\#}" amount="$3" i channel_a channel_b out=""
  for i in 0 2 4; do
    channel_a=$((16#${a:$i:2}))
    channel_b=$((16#${b:$i:2}))
    out+=$(printf '%02x' $(( (channel_a * (100 - amount) + channel_b * amount + 50) / 100 )))
  done
  printf '#%s' "$out"
}

background=$(read_color background)
foreground=$(read_color foreground)
accent=$(read_color accent)

# A theme with no accent is legal; fall back to the foreground rather than
# writing an invalid file that Sidra would silently reject.
[[ -n $background && -n $foreground ]] || {
  echo "omarchy-sidra-theme-sync: colors.toml has no background/foreground" >&2; exit 1; }
[[ -n $accent ]] || accent="$foreground"

black="#000000"

base=$background
mantle=$(mix "$background" "$black" 20)
crust=$(mix "$background" "$black" 42)
surface0=$(mix "$background" "$foreground" 11)
surface1=$(mix "$background" "$foreground" 22)
surface2=$(mix "$background" "$foreground" 33)
overlay=$(mix "$background" "$foreground" 45)
text=$foreground
subtext1=$(mix "$foreground" "$background" 11)
subtext0=$(mix "$foreground" "$background" 22)
accent_hover=$(mix "$accent" "$foreground" 25)

theme_name="unknown"
[[ -r $STATE/theme.name ]] && read -r theme_name <"$STATE/theme.name" || true

mkdir -p "$USERDATA"

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

# "light" is omitted deliberately: Sidra falls back to the dark scheme for it,
# and an Omarchy theme carries one palette, not a pair.
cat >"$tmp" <<JSON
{
  "_comment": "GENERATED by omarchy-sidra-theme-sync from the '$theme_name' Omarchy theme -- do not edit.",
  "dark": {
    "base": "$base",
    "mantle": "$mantle",
    "crust": "$crust",
    "surface0": "$surface0",
    "surface1": "$surface1",
    "surface2": "$surface2",
    "overlay": "$overlay",
    "text": "$text",
    "subtext1": "$subtext1",
    "subtext0": "$subtext0",
    "accent": "$accent",
    "accentHover": "$accent_hover"
  }
}
JSON

mv "$tmp" "$TARGET"
trap - EXIT

# Select the custom theme, but only on a first run: Sidra's config.json also
# holds the Last.fm session, zoom and page state, and clobbering that to set one
# key would be rude. If it already exists, the user's choice stands.
if [[ ! -e $USERDATA/config.json ]]; then
  printf '{\n  "theme": "custom"\n}\n' >"$USERDATA/config.json"
  echo "sidra: wrote config.json selecting the custom theme"
fi

echo "sidra theme synced: $theme_name"
