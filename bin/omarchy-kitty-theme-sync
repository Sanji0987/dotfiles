#!/bin/bash
# Regenerate ~/.config/kitty/current-theme.conf from the active Omarchy theme.
#
# kitty.conf has always ended with `include current-theme.conf`. That file used
# to be written by `kitten themes` and held whatever was picked last (Moonfly,
# as it turned out) -- so the terminal ignored the desktop theme entirely. Now
# it is generated, in two layers:
#
#   1. ~/.local/state/omarchy/current/theme/kitty.conf
#      Omarchy's own render of the theme's colors.toml. Exists for every theme
#      that has a colors.toml, which is every theme here.
#   2. config/kitty/themes/<slug>.conf, if this repo has one
#      A reviewed extract of a theme's own kitty.conf, appended second so it
#      wins. Needed because Omarchy refuses a cloned theme's kitty.conf, and
#      some themes (rainynight) ship a terminal palette that is deliberately
#      different from their colors.toml.
#
# Run by the theme-set.d/kitty-theme hook on every theme change, and directly
# by resync.sh, which sets OMARCHY_THEME_HEADLESS and so skips hooks.

set -euo pipefail

# Self-locating: reached through the ~/.local/bin symlink, so readlink -f first
# or SELF_DIR is ~/.local/bin. Same requirement as resync.sh.
SELF_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd -- "$SELF_DIR/.." && pwd)"

STATE="$HOME/.local/state/omarchy/current"
GENERATED="$STATE/theme/kitty.conf"
OVERRIDE_DIR="$REPO_DIR/config/kitty/themes"
TARGET="$HOME/.config/kitty/current-theme.conf"

theme_name=""
[[ -r $STATE/theme.name ]] && read -r theme_name <"$STATE/theme.name" || true

# A slug on its way into a file path: refuse anything else rather than trust it.
[[ $theme_name =~ ^[A-Za-z0-9._-]+$ ]] || theme_name=""

if [[ ! -r $GENERATED ]]; then
  echo "omarchy-kitty-theme-sync: no generated palette at $GENERATED" >&2
  exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

{
  echo "# vim:ft=kitty"
  echo "#"
  echo "# GENERATED by omarchy-kitty-theme-sync -- do not edit."
  echo "# Theme: ${theme_name:-unknown}"
  echo "# Edit the palette at its source instead:"
  echo "#   colours      ~/.config/omarchy/themes/<theme>/colors.toml"
  echo "#   per-theme    ~/dotfiles/config/kitty/themes/<theme>.conf"
  echo
  cat "$GENERATED"

  if [[ -n $theme_name && -r $OVERRIDE_DIR/$theme_name.conf ]]; then
    echo
    echo "# ---- config/kitty/themes/$theme_name.conf ----"
    cat "$OVERRIDE_DIR/$theme_name.conf"
  fi
} >"$tmp"

mv "$tmp" "$TARGET"
trap - EXIT

# kitty rereads its config on SIGUSR1, so running terminals retint in place.
if pgrep -x kitty >/dev/null; then
  pkill -USR1 -x kitty || true
fi

echo "kitty theme synced: ${theme_name:-unknown}"
