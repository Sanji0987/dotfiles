#!/usr/bin/env bash
# Toggle the built-in panel between 60 Hz and 144 Hz.
#
#   -n, --notify   desktop notification (default)
#   -q, --quiet    change the mode, say nothing
#   -p, --print    print the new rate to stdout instead of notifying
#   -s, --status   report the current rate and change nothing
#   -h, --help     this text
#
# There is no gsettings key for refresh rate. This drives `gdctl`, the display
# CLI that ships inside mutter itself (GNOME 48+) -- `rpm -qf $(which gdctl)`
# says mutter. An earlier version of this script spoke to the underlying
# org.gnome.Mutter.DisplayConfig D-Bus API by hand; it is in the git history if
# gdctl is ever missing, but there is no reason to prefer it.

set -euo pipefail

LOW=60
HIGH=144
CROSSOVER=100   # above this counts as "currently on high"
TOLERANCE=5     # refuse if the nearest mode is further than this from target

MODE=notify
case "${1:-}" in
  -n|--notify) MODE=notify ;;
  -q|--quiet)  MODE=quiet ;;
  -p|--print)  MODE=print ;;
  -s|--status) MODE=status ;;
  -h|--help)   sed -n '2,15p' "$0" | sed 's/^# \?//'; exit 0 ;;
  "")          ;;
  *)           echo "${0##*/}: unknown option: $1" >&2; exit 2 ;;
esac

say() {
  case "$MODE" in
    notify) notify-send -e -t 1500 -a toggle-refresh-rate \
              -h string:x-canonical-private-synchronous:toggle-refresh-rate "$1" ;;
    print|status) printf '%s\n' "$1" ;;
    quiet)  ;;
  esac
}

command -v gdctl >/dev/null || {
  echo "${0##*/}: gdctl not found -- needs mutter 48 or newer" >&2; exit 1; }

# Two calls on purpose: `gdctl show -m` REPLACES the "Current mode" line with
# the full mode list, so neither view has everything.
info=$(gdctl show)       # connector, current mode, scale
modes=$(gdctl show -m)   # every mode the panel offers

connector=$(sed -n 's/.*Monitor \([A-Za-z0-9-]\{1,\}\) (.*/\1/p' <<<"$info" | head -1)
current=$(awk '/Current mode/{getline; gsub(/[^0-9x@.]/,""); print; exit}' <<<"$info")
[[ -n "$connector" && -n "$current" ]] || { echo "${0##*/}: could not read current mode" >&2; exit 1; }

res="${current%@*}"      # 1920x1080
rate="${current#*@}"     # 144.003

if [[ "$MODE" == status ]]; then
  say "$(printf '%.0f Hz' "$rate")"
  exit 0
fi

target=$HIGH
awk -v r="$rate" -v c="$CROSSOVER" 'BEGIN{exit !(r>=c)}' && target=$LOW

# Stay at the current resolution; take whichever mode is nearest the target.
best=$(grep -oE "${res}@[0-9.]+" <<<"$modes" | sort -u | awk -v t="$target" -v tol="$TOLERANCE" '
  { split($0, a, "@"); d = a[2] - t; if (d < 0) d = -d
    if (best == "" || d < bd) { bd = d; best = $0 } }
  END { if (best != "" && bd <= tol) print best }')

[[ -n "$best" ]] || { say "No ~${target} Hz mode at ${res}"; exit 1; }
[[ "$best" != "$current" ]] || { say "Already $(printf '%.0f' "$rate") Hz"; exit 0; }

# Carry the scale over -- gdctl set rebuilds the logical monitor, so a
# non-default scale would silently reset to 1.0 if it were not passed.
scale=$(sed -n 's/.*Scale: \([0-9.]\{1,\}\).*/\1/p' <<<"$info" | head -1)

gdctl set --persistent --logical-monitor --primary \
          --monitor "$connector" --mode "$best" --scale "${scale:-1.0}"

say "$(printf '%.0f Hz' "${best#*@}")"
