#!/usr/bin/env bash
# Install the omarchy-generated Walker stylesheet into Walker's theme dir,
# resolving the geometry tokens omarchy's template engine cannot.
#
# TWO-STAGE RENDER
# ----------------
# omarchy-theme-set-templates:383 builds its sed script purely from
# THEME_COLORS, which :380 fills from colors.toml alone. It therefore has no
# {{ rounding }} or {{ icon_large }} — geometry lives in shell.toml's [font]
# and [spacing] sections and in Hyprland's decoration:rounding, none of which
# that engine reads.
#
# sed only rewrites tokens it has a rule for, so an unknown {{ token }} passes
# through stage 1 untouched. That is the whole trick:
#
#   ~/.config/omarchy/themed/walker.css.tpl
#     |  stage 1 - omarchy-theme-set-templates: {{ colour }} tokens
#     v
#   ~/.local/state/omarchy/current/theme/walker.css   (still holds {{ ui_* }})
#     |  stage 2 - this script: {{ ui_* }} geometry tokens
#     v
#   ~/.config/walker/themes/omarchy/style.css
#
# Every geometry token is namespaced ui_*. No colors.toml key begins with
# "ui_", so stage 1 can never claim one by accident.
#
# WHY A COPY INSTEAD OF A SYMLINK:
# Walker silently ignores a symlinked themes/<name>/style.css. Verified by
# putting deliberately invalid CSS at that path both ways:
#   real file -> GTK prints "Theme parser error: style.css:1:24-25"
#   symlink   -> no parser output at all; the file is never read
# So the stylesheet has to be a real file, and something has to render it
# after every theme change. That something is this script.
#
# Called from:
#   ~/.config/omarchy/hooks/theme-set.d/walker-css   (normal theme changes)
#   ~/omarchy_config_work/update.sh                  (OMARCHY_THEME_HEADLESS=1
#                                                     runs, where hooks are
#                                                     skipped by
#                                                     omarchy-theme-set:207)
set -euo pipefail

SRC="$HOME/.local/state/omarchy/current/theme/walker.css"
DST="$HOME/.config/walker/themes/omarchy/style.css"
THEME_SHELL="$HOME/.local/state/omarchy/current/theme/shell.toml"
USER_SHELL="$HOME/.config/omarchy/shell.toml"

die() {
  echo "omarchy-walker-theme-sync: $*" >&2
  exit 1
}

[[ -r $SRC ]] || die "$SRC not found - is ~/.config/omarchy/themed/walker.css.tpl in place?"

# ------------------------------------------------------------- shell.toml

# One key out of one section. Quoted values are taken verbatim up to the
# closing quote, so a "#101315" colour is not mistaken for a comment.
toml_get() {
  local file=$1 section=$2 key=$3
  [[ -r $file ]] || return 0
  awk -v section="$section" -v key="$key" '
    /^[[:space:]]*\[/ {
      s = $0
      sub(/^[[:space:]]*\[/, "", s)
      sub(/\].*$/, "", s)
      cur = s
      next
    }
    cur != section { next }
    {
      if (match($0, "^[[:space:]]*" key "[[:space:]]*=")) {
        v = substr($0, RSTART + RLENGTH)
        sub(/^[[:space:]]+/, "", v)
        if (substr(v, 1, 1) == "\"") {
          v = substr(v, 2)
          sub(/".*$/, "", v)
        } else {
          sub(/[[:space:]]*#.*$/, "", v)
          sub(/[[:space:]]+$/, "", v)
        }
        print v
        exit
      }
    }
  ' "$file"
}

# A machine-level ~/.config/omarchy/shell.toml wins over the theme's, which
# is the precedence Color.qml:202 applies before handing the dict to Style.
shell_get() {
  local v
  v=$(toml_get "$USER_SHELL" "$1" "$2")
  [[ -n $v ]] || v=$(toml_get "$THEME_SHELL" "$1" "$2")
  printf '%s' "$v"
}

# ---------------------------------------------------------------- rounding

# Style.qml:359 reads hyprctl's .int and ignores anything negative or
# unparseable, leaving its own `property int cornerRadius: 0` default.
resolve_rounding() {
  local raw n
  raw=$(hyprctl -j getoption decoration:rounding 2>/dev/null) || raw=""
  n=$(printf '%s' "$raw" | sed -n 's/.*"int"[[:space:]]*:[[:space:]]*\(-\?[0-9]\+\).*/\1/p')
  [[ $n =~ ^[0-9]+$ ]] || n=0
  printf '%s' "$n"
}

# ------------------------------------------------------------------ border

# [menu] border is an indirection into [hyprland], whose value is a Hyprland
# gradient ("rgba(798186ee) rgba(caccccee) 45deg"). GTK cannot paint a
# gradient border, so we deliberately collapse it to its first stop and drop
# the alpha byte. That simplification is intentional, not an oversight.
resolve_border() {
  local v ref
  v=$(shell_get menu border)
  if [[ $v == hyprland.* ]]; then
    ref=${v#hyprland.}
    v=$(shell_get hyprland "$ref")
  fi
  v=${v%% *}
  v=${v#rgba(}
  v=${v#rgb(}
  v=${v%)}
  v=${v#\#}
  v=${v:0:6}
  [[ $v =~ ^[0-9A-Fa-f]{6}$ ]] || v=$(shell_get menu text)
  v=${v#\#}
  [[ $v =~ ^[0-9A-Fa-f]{6}$ ]] || v=cacccc
  printf '#%s' "$v"
}

# ------------------------------------------------------------------- solve

# Mirrors Commons/Style.qml:213-229 (space/spacingToken) and :284-340
# (fontScale/fontPx/fontToken) exactly. Keep the two in step.
eval "$(
  awk \
    -v base="$(shell_get font base-size)" \
    -v sscale="$(shell_get spacing scale)" \
    -v swf="$(shell_get spacing scale-with-font)" \
    -v o_caption="$(shell_get font caption)" \
    -v o_body_small="$(shell_get font body-small)" \
    -v o_body="$(shell_get font body)" \
    -v o_title="$(shell_get font title)" \
    -v o_heading="$(shell_get font heading)" \
    -v o_icon_large="$(shell_get font icon-large)" \
    -v o_display="$(shell_get font display)" \
    -v o_xs="$(shell_get spacing xs)" \
    -v o_panel_padding="$(shell_get spacing panel-padding)" \
    -v o_row_padding_x="$(shell_get spacing row-padding-x)" \
    -v o_control_padding_y="$(shell_get spacing control-padding-y)" \
    'function round(x) { return int(x + 0.5) }
     function fontPx(m,   n) { n = round(base * m); return n < 1 ? 1 : n }
     function fontToken(o, fb,   n) {
       if (o == "") return fb
       n = o + 0
       return n > 0 ? round(n) : fb
     }
     function space(px,   n) {
       n = px * ess
       if (n <= 0) return 0
       n = round(n)
       return n < 1 ? 1 : n
     }
     function spacingToken(o, fb,   n) {
       if (o == "") return space(fb)
       n = o + 0
       return n >= 0 ? round(n) : space(fb)
     }
     BEGIN {
       if (base + 0 <= 0) base = 12
       fontScale = base / 12
       if (fontScale < 1 / 12) fontScale = 1 / 12

       if (sscale + 0 <= 0) sscale = 1.0
       withFont = 1
       if (swf == "false" || swf == "0" || swf == "no" || swf == "off") withFont = 0
       ess = sscale * (withFont ? fontScale : 1)

       body         = fontToken(o_body,       fontPx(1.0))
       caption      = fontToken(o_caption,    fontPx(0.833))
       rowPaddingX  = spacingToken(o_row_padding_x, 12)

       # Menu.qml:102 - baseRowHeight
       rowHeight = space(50)
       alt = body + rowPaddingX * 2
       if (alt > rowHeight) rowHeight = alt

       # Menu.qml:100 - headerHeight
       headerHeight = space(34)
       alt = fontToken(o_title, fontPx(1.167)) + spacingToken(o_control_padding_y, 6) * 2
       if (alt > headerHeight) headerHeight = alt

       printf "UI_PANEL_PADDING=%d\n", spacingToken(o_panel_padding, 18)
       printf "UI_ROW_PADDING_X=%d\n", rowPaddingX
       printf "UI_ROW_GAP=%d\n",       spacingToken(o_xs, 3)
       printf "UI_ROW_HEIGHT=%d\n",    rowHeight
       printf "UI_HEADER_HEIGHT=%d\n", headerHeight
       printf "UI_ICON_LARGE=%d\n",    fontToken(o_icon_large, fontPx(1.5))
       printf "UI_HEADING=%d\n",       fontToken(o_heading,    fontPx(1.333))
       printf "UI_BODY_SMALL=%d\n",    fontToken(o_body_small, fontPx(0.917))
       printf "UI_DISPLAY=%d\n",       fontToken(o_display,    fontPx(2.0))
     }'
)"

UI_ROUNDING=$(resolve_rounding)
UI_MENU_BORDER=$(resolve_border)

# --------------------------------------------------------------- stage two

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

sed -e "s|{{ ui_rounding }}|$UI_ROUNDING|g" \
    -e "s|{{ ui_panel_padding }}|$UI_PANEL_PADDING|g" \
    -e "s|{{ ui_row_padding_x }}|$UI_ROW_PADDING_X|g" \
    -e "s|{{ ui_row_gap }}|$UI_ROW_GAP|g" \
    -e "s|{{ ui_row_height }}|$UI_ROW_HEIGHT|g" \
    -e "s|{{ ui_header_height }}|$UI_HEADER_HEIGHT|g" \
    -e "s|{{ ui_icon_large }}|$UI_ICON_LARGE|g" \
    -e "s|{{ ui_heading }}|$UI_HEADING|g" \
    -e "s|{{ ui_body_small }}|$UI_BODY_SMALL|g" \
    -e "s|{{ ui_display }}|$UI_DISPLAY|g" \
    -e "s|{{ ui_menu_border }}|$UI_MENU_BORDER|g" \
    "$SRC" >"$tmp"

# A stray {{ ui_x }} reaching GTK is a CSS parser error, and walker then
# degrades silently to its stock theme. Refuse to install rather than let
# that happen quietly.
if grep -q '{{' "$tmp"; then
  die "unresolved template tokens: $(grep -o '{{[^}]*}}' "$tmp" | sort -u | tr '\n' ' ')"
fi

mkdir -p "${DST%/*}"
cp -f "$tmp" "$DST"
chmod 644 "$DST"

# Walker parses its CSS once, when the gapplication-service starts. Without a
# restart the new stylesheet would not appear until the next login.
#
# try-restart is a no-op when the unit is stopped, so this never starts walker
# on a machine where it is deliberately off. The pkill branch is the fallback
# for a service started by hand rather than by systemd.
if systemctl --user list-unit-files walker.service >/dev/null 2>&1 \
   && systemctl --user cat walker.service >/dev/null 2>&1; then
  systemctl --user try-restart walker.service || true
elif pgrep -f 'walker --gapplication-service' >/dev/null 2>&1; then
  pkill -f 'walker --gapplication-service' || true
  setsid walker --gapplication-service >/dev/null 2>&1 &
fi
