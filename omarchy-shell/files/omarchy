#!/bin/bash
# Run any omarchy CLI command from outside the shell's own process.
#
# On a real Omarchy box, OMARCHY_PATH is exported from the uwsm session
# environment and $OMARCHY_PATH/bin is on PATH system-wide. Here neither is
# true: omarchy-shell-run scopes both to the shell process, so nothing outside
# that process can reach them. `omarchy-menu toggle apps` from a terminal or a
# Hyprland bind fails at `exec: omarchy-shell: not found` (exit 127).
#
# So this shim sets the same two variables omarchy-shell-run does and hands off
# to the real dispatcher. Everything downstream then resolves normally:
#
#   omarchy menu toggle apps      # the shell's app launcher
#   omarchy shell ping            # IPC health check
#   omarchy shell listPlugins
#   omarchy theme list
#   omarchy                       # no args: the full command index
#
# Deliberately NOT setting FONTCONFIG_FILE — that alias is scoped to the
# rendering process (the shell) and has no business in a CLI call.

export OMARCHY_PATH="$HOME/.local/share/omarchy"

# Prepended, not appended: the 431 omarchy-* scripts call each other by bare
# name, and a same-named script earlier on PATH would win.
case ":$PATH:" in
  *":$OMARCHY_PATH/bin:"*) ;;
  *) export PATH="$OMARCHY_PATH/bin:$PATH" ;;
esac

if [[ ! -x $OMARCHY_PATH/bin/omarchy ]]; then
  echo "omarchy dispatcher not found at $OMARCHY_PATH/bin/omarchy" >&2
  exit 1
fi

# Absolute path, never a bare `omarchy` — this file is itself on PATH and a
# bare name would re-enter it forever.
exec "$OMARCHY_PATH/bin/omarchy" "$@"
