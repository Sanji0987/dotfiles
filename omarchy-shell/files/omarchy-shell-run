#!/bin/bash
# Launch omarchy-shell (Omarchy 4 "Quattro" Quickshell desktop shell)
# standalone on a non-Omarchy system.
#
# Omarchy normally exports OMARCHY_PATH from its uwsm session environment and
# puts its bin/ on PATH system-wide. Here we scope both to this process so the
# rest of the desktop is untouched.

export OMARCHY_PATH="$HOME/.local/share/omarchy"

case ":$PATH:" in
  *":$OMARCHY_PATH/bin:"*) ;;
  *) export PATH="$OMARCHY_PATH/bin:$PATH" ;;
esac

# Point the shell's "monospace" alias at a Nerd Font without touching the
# system-wide monospace. See ~/.config/omarchy/fontconfig.conf.
if [[ -f $HOME/.config/omarchy/fontconfig.conf ]]; then
  export FONTCONFIG_FILE="$HOME/.config/omarchy/fontconfig.conf"
fi

if ! command -v quickshell >/dev/null 2>&1; then
  echo "quickshell is not installed. Install it with:" >&2
  echo "  yay -S quickshell-git" >&2
  exit 1
fi

if [[ ! -f $OMARCHY_PATH/shell/shell.qml ]]; then
  echo "omarchy-shell not found at $OMARCHY_PATH/shell/shell.qml" >&2
  exit 1
fi

# Matches bin/omarchy-launch-shell: Quickshell's own hot reload is off because
# Omarchy restarts the shell deliberately, and a half-written tree would
# otherwise reload into a broken second engine generation.
export QS_DISABLE_FILE_WATCHER=1
export QS_NO_RELOAD_POPUP=1

exec quickshell -n -p "$OMARCHY_PATH/shell" "$@"
