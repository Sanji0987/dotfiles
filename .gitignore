# personal scratch notes, not part of the config
*.local.md
local/

# backups
*.bak
*.bak.*
*.pre-dotfiles

# machine state, not config
config/fish/fish_variables
omarchy-shell/state/

# generated on every theme change (stage-2 render output)
config/walker/themes/omarchy/style.css

# edited by claude opus 5
# kitty's palette is generated now, so the deployed copy must not be tracked
# Generated on every theme change by omarchy-kitty-theme-sync. kitty.conf
# includes it; ~/.config/kitty is this directory, so the render lands inside
# the repo. Edit the sources instead: the theme's colors.toml, or the reviewed
# per-theme extract in config/kitty/themes/<slug>.conf.
config/kitty/current-theme.conf

# edited by claude sonnet 5
# documented why waybar needs no ignore entry, so it is not added later by mistake
# waybar has no equivalent entry here: config/waybar/style.css @imports
# ~/.local/state/omarchy/current/theme/waybar.css directly, and that render
# target sits entirely outside this repo (no symlinked config/waybar/* path
# ever gets written to), so there is nothing generated inside the tree to
# ignore.

# third-party theme clones + wallpapers — installed once via
# `omarchy-shell-update --theme <git-url>`, see omarchy-shell/NOTES.md
config/omarchy/themes/
config/omarchy/backgrounds/
